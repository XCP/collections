{
  "name": "@xcp/collections",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "imports": {
    "#lib/*": "./lib/*.ts",
    "#scripts/*": "./scripts/*.ts",
    "#aggregators/*": "./aggregators/*/adapter.ts",
    "#collections/*": "./collections/*/adapter.ts"
  },
  "scripts": {
    "validate": "node .github/validate.ts",
    "coverage": "node .github/check-source-coverage.ts",
    "test": "node .github/run-tests.ts",
    "export": "node scripts/export.ts",
    "check": "npm run validate && npm run coverage && npm test && npm run export"
  }
}
